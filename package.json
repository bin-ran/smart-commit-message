{
  "name": "smart-git-commit-message",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.3",
  "publisher": "binran",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "icon": "icon.png",
  "keywords": [
    "git",
    "commit",
    "ai",
    "smart-commit-message",
    "deepseek"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bin-ran/smart-commit-message.git"
  },
  "bugs": {
    "url": "https://github.com/bin-ran/smart-commit-message/issues"
  },
  "homepage": "https://github.com/bin-ran/smart-commit-message#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:smartCommitMessage.generate",
    "onCommand:smartCommitMessage.setApiKey",
    "onCommand:smartCommitMessage.clearApiKey",
    "onCommand:smartCommitMessage.openSettings",
    "onCommand:smartCommitMessage.exportConfig",
    "onCommand:smartCommitMessage.importConfig"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Generating a commit message sends the git diff of the workspace to a remote AI service, so the extension is disabled in restricted mode."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "smartCommitMessage.generate",
        "title": "%command.generate.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "smartCommitMessage.setApiKey",
        "title": "%command.setApiKey.title%"
      },
      {
        "command": "smartCommitMessage.clearApiKey",
        "title": "%command.clearApiKey.title%"
      },
      {
        "command": "smartCommitMessage.openSettings",
        "title": "%command.openSettings.title%",
        "icon": "$(gear)"
      },
      {
        "command": "smartCommitMessage.exportConfig",
        "title": "%command.exportConfig.title%"
      },
      {
        "command": "smartCommitMessage.importConfig",
        "title": "%command.importConfig.title%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "smartCommitMessage.generate",
          "group": "navigation@-10",
          "when": "scmProvider == git"
        },
        {
          "command": "smartCommitMessage.openSettings",
          "group": "navigation@-11",
          "when": "scmProvider == git"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "smartCommitMessage.apiKey": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "%config.apiKey.description%",
          "deprecationMessage": "%config.apiKey.deprecation%"
        },
        "smartCommitMessage.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "scope": "machine",
          "description": "%config.baseUrl.description%"
        },
        "smartCommitMessage.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "scope": "machine",
          "description": "%config.model.description%"
        },
        "smartCommitMessage.style": {
          "type": "string",
          "enum": [
            "conventional",
            "simple",
            "detailed"
          ],
          "default": "conventional",
          "description": "%config.style.description%"
        },
        "smartCommitMessage.language": {
          "type": "string",
          "enum": [
            "English",
            "Chinese"
          ],
          "description": "%config.language.description%"
        },
        "smartCommitMessage.customPrompt": {
          "type": "string",
          "default": "",
          "description": "%config.customPrompt.description%"
        },
        "smartCommitMessage.maxDiffChars": {
          "type": "number",
          "default": 8000,
          "minimum": 100,
          "description": "%config.maxDiffChars.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --max-warnings 0",
    "test": "pnpm run compile && node --test \"out/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/vscode": "^1.140.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
